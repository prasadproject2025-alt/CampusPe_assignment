{
  "name": "campuspe-job-application-automation",
  "version": "1.0.0",
  "description": "Production-grade Playwright + TypeScript Job Application Automation System with fault tolerance, session recovery, and checkpointing.",
  "main": "dist/server/index.js",
  "scripts": {
    "build": "tsc",
    "server": "ts-node server/index.ts",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "demo:happy-path": "ts-node scripts/run-demo.ts happy-path",
    "demo:happy": "ts-node scripts/run-demo.ts happy-path",
    "demo:session-expiry": "ts-node scripts/run-demo.ts session-expiry",
    "demo:expiry": "ts-node scripts/run-demo.ts session-expiry",
    "demo:network-timeout": "ts-node scripts/run-demo.ts network-timeout",
    "demo:transient": "ts-node scripts/run-demo.ts network-timeout",
    "demo:browser-crash": "ts-node scripts/run-demo.ts browser-crash",
    "demo:crash": "ts-node scripts/run-demo.ts browser-crash",
    "demo:duplicate-submission": "ts-node scripts/run-demo.ts duplicate-submission",
    "demo:idempotency": "ts-node scripts/run-demo.ts duplicate-submission",
    "demo:all": "ts-node scripts/run-demo.ts all",
    "vercel-build": "tsc"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "reliability",
    "campuspe",
    "resilience",
    "state-machine"
  ],
  "author": "Prasad / Candidate",
  "license": "MIT",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "uuid": "^11.0.5",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.1",
    "@types/uuid": "^10.0.0",
    "playwright": "^1.50.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
