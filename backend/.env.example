# Live Ashby Test Configuration
# These are required for running npm run test:live-ashby
# Do not put real personal values in this file

TEST_ASHBY_JOB_URL=
TEST_CANDIDATE_NAME=
TEST_CANDIDATE_EMAIL=
TEST_CANDIDATE_RESUME_PATH=

# Optional
TEST_CANDIDATE_PHONE=
TEST_CANDIDATE_LINKEDIN_URL=
TEST_CANDIDATE_LOCATION=

# CAPTCHA Session Configuration
# How long (in milliseconds) to preserve browser session when CAPTCHA is detected
# Default: 600000 (10 minutes)
CAPTCHA_SESSION_TIMEOUT_MS=600000

# CAPTCHA Monitoring Configuration
# How often (in milliseconds) to check if CAPTCHA has been cleared
# Default: 2000 (2 seconds)
CAPTCHA_MONITOR_INTERVAL_MS=2000

# CAPTCHA Solver API Key (optional - for future automated solving)
# If provided, can be used for automated CAPTCHA resolution
# DO NOT commit real keys to git
CAPSOLVER_API_KEY=
